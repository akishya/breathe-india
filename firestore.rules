rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerId(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidCreation(data, creationId) {
      return data.keys().hasAll(['id', 'ownerId', 'kind', 'title', 'content', 'modelUsed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'kind', 'title', 'content', 'modelUsed', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == creationId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.kind is string && data.kind in ['research', 'transcript', 'image_prompt', 'video_prompt', 'music_prompt', 'scene_preset']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 8000
        && data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidPlace(data, placeDocId) {
      return data.keys().hasAll(['id', 'ownerId', 'placeId', 'name', 'address', 'lat', 'lng', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'placeId', 'name', 'address', 'lat', 'lng', 'note', 'createdAt'])
        && data.id is string && data.id == placeDocId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.placeId is string && data.placeId.size() >= 1 && data.placeId.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 300
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidGameScore(data, scoreId) {
      return data.keys().hasAll(['id', 'ownerId', 'playerName', 'score', 'wave', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'playerName', 'score', 'wave', 'createdAt'])
        && data.id is string && data.id == scoreId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 80
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.wave is number && data.wave >= 1 && data.wave <= 1000
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    // Connection probe path (read-only ping)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwnerId(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isVerified() && isOwnerId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isVerified() && isOwnerId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwnerId(userId);
    }

    match /creations/{creationId} {
      allow get: if isValidId(creationId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(creationId) && isVerified() && isValidCreation(incoming(), creationId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(creationId) && isVerified() && existing().ownerId == request.auth.uid
        && isValidCreation(incoming(), creationId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'kind', 'modelUsed', 'updatedAt']);
      allow delete: if isValidId(creationId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /places/{placeDocId} {
      allow get: if isValidId(placeDocId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(placeDocId) && isVerified() && isValidPlace(incoming(), placeDocId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(placeDocId) && isVerified() && existing().ownerId == request.auth.uid
        && isValidPlace(incoming(), placeDocId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['note']);
      allow delete: if isValidId(placeDocId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /gameScores/{scoreId} {
      allow get: if isValidId(scoreId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(scoreId) && isVerified() && isValidGameScore(incoming(), scoreId);
      allow update: if false;
      allow delete: if isValidId(scoreId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
