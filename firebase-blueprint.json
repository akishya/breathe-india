{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile isolated to the authenticated owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile sync"
        }
      },
      "required": ["uid", "displayName", "email", "updatedAt"]
    },
    "SavedCreation": {
      "title": "SavedCreation",
      "description": "Saved user workspace artifacts such as notes, transcripts, research summaries, and creative prompts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["research", "transcript", "image_prompt", "video_prompt", "music_prompt", "scene_preset"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "modelUsed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "kind", "title", "content", "modelUsed", "createdAt", "updatedAt"]
    },
    "SavedPlace": {
      "title": "SavedPlace",
      "description": "A Google Maps place pinned by the authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "placeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "placeId", "name", "address", "lat", "lng", "createdAt"]
    },
    "GameScore": {
      "title": "GameScore",
      "description": "Arcade game high score record owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "score": {
          "type": "number"
        },
        "wave": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "playerName", "score", "wave", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents readable and writable only by the owner."
    },
    "/creations/{creationId}": {
      "schema": { "$ref": "#/entities/SavedCreation" },
      "description": "User-owned saved research, transcripts, prompts, and 3D scene presets."
    },
    "/places/{placeDocId}": {
      "schema": { "$ref": "#/entities/SavedPlace" },
      "description": "User-owned pinned Google Maps locations."
    },
    "/gameScores/{scoreId}": {
      "schema": { "$ref": "#/entities/GameScore" },
      "description": "User-owned Orbital Relay arcade score records."
    }
  }
}
